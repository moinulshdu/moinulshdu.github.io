---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }} — Articles</title>
  <link>{{ '/' | absolute_url }}</link>
  <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
  <description>{{ site.description | normalize_whitespace | xml_escape }}</description>
  {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}{% for post in posts limit: 20 %}
  <item>
    <title>{{ post.title | xml_escape }}</title>
    <link>{{ post.url | absolute_url }}</link>
    <guid>{{ post.url | absolute_url }}</guid>
    <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    <description>{{ post.summary | default: post.excerpt | strip_html | xml_escape }}</description>
  </item>{% endfor %}
</channel>
</rss>
